{
  "name": "qbizpro-studio",
  "productName": "QBizPro Social Media Content Studio",
  "version": "0.1.0",
  "description": "Studio konten media sosial untuk produk IT: editor, motion graphics, Brand Roulette Intro, dan ekspor video lokal.",
  "main": "src/main/main.cjs",
  "type": "module",
  "author": "QBizPro",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-all.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win zip"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.0.12",
    "@napi-rs/canvas": "1.0.13",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "id.qbizpro.studio",
    "productName": "QBizPro Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!tests/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "QBizPro-Studio-Setup-${version}.${ext}"
    }
  }
}
